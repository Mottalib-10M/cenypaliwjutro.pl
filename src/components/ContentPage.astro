---
/**
 * Rendu d'une page de contenu (`src/content/strony/`) : H1 et phrase d'intro, bloc citable replié (§21, §26),
 * le calculateur (premier écran, §9.3), la ligne de source, puis le corps. FAQ, pages liées, sources et signature
 * viennent du PageLayout.
 */
import { zrodla } from '../lib/zrodla';
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Narzedzie from './Narzedzie.astro';
import { route, ROUTES, type Locale } from '../i18n/routes';
import { label } from '../i18n/nav';
import { t } from '../i18n/ui';
import { pageById } from '../lib/strony';
import { helpers } from '../lib/helpers';
import { P } from '../lib/params';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import { OSTATNIA, WOB } from '../lib/dane';
import type { PageDef } from '../lib/strona-typy';
interface Props { page: PageDef; lang: Locale }
const { page, lang } = Astro.props;
const x = page[lang];
const ui = t(lang);
const path = route(page.id, lang);
const H = helpers(lang);
const resume = x.resume(H);
const faqs = x.faqs(H);
const title = typeof x.title === 'function' ? x.title(H) : x.title;
const description = typeof x.description === 'function' ? x.description(H) : x.description;
const jsonLd = [articleSchema({ title: x.h1, description, path, lang }), webPageSchema({ name: x.h1, description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: x.nav, path }]), webApplicationSchema({ name: x.h1, description, path, lang })];
if (faqs.length) jsonLd.push(faqSchema(faqs, lang));
const related = page.related.filter((id) => ROUTES.some((r) => r.id === id)).map((id) => ({ href: route(id, lang), name: label(id, lang), description: pageById(id)?.[lang].card ?? '' }));
const sources = zrodla(page.sources, lang);
const methodHref = route('method', lang);
const pl = lang === 'pl';
const wob = ['europa', 'srednia', 'lpg'].includes(page.tool);
---
<PageLayout title={title} description={description} lang={lang} jsonLd={jsonLd} faqs={faqs} related={related} sources={sources} breadcrumbs={[{ label: x.nav }]}>
  <article>
    <header class="mb-3">
      <h1 class="text-2xl font-bold text-navy-900 md:text-3xl">{x.h1}</h1>
      <p class="mt-1 text-base text-navy-700 md:text-lg">{x.intro(H)}</p>
    </header>
    <Clamp text={resume} lang={lang} id={`clamp-${page.id}`} class="mb-3" />
    <div data-outil>
      <Narzedzie tool={page.tool} lang={lang} opts={page.toolProps} methodHref={methodHref} />
    </div>
    <p class="mt-2 text-sm text-navy-600" data-chrome>
      {wob
        ? <>{pl ? 'Dane: tygodniowy biuletyn cen paliw Komisji Europejskiej, tydzień od ' : 'Data: European Commission Weekly Oil Bulletin, week of '}<time datetime={WOB.tydzien}>{H.date(WOB.tydzien)}</time></>
        : <>{pl ? 'Dane: obwieszczenia Ministra Energii, ostatnie ogłoszone ' : 'Data: Minister of Energy notices, latest announced on '}<time datetime={OSTATNIA.ogl}>{H.date(OSTATNIA.ogl)}</time></>}
      {' · '}{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={methodHref} class="underline hover:text-navy-900">{label('method', lang)}</a>
    </p>
    <p class="mt-1 text-sm text-navy-600" data-chrome>{ui.independent}</p>
    <div class="prose prose-slate mt-6 max-w-none">
      <Fragment set:html={x.body(H)} />
    </div>
  </article>
</PageLayout>
