---
/**
 * Accueil d'une langue (page pilier, RECETTE §5) : prix maximal en vigueur au premier écran avec le calculateur du
 * plein, cartes (gazole, 95, prochaine annonce, LPG), texte, puis l'index des pages par famille. Textes : content/strona-glowna.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Narzedzie from './Narzedzie.astro';
import { HOME } from '../content/strona-glowna';
import { route, type Locale } from '../i18n/routes';
import { navCategories } from '../i18n/nav';
import { t } from '../i18n/ui';
import { helpers } from '../lib/helpers';
import { P, type SourceKey } from '../lib/params';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { OSTATNIA, POPRZEDNIA, LPG_ZL, WOB_OST, widelki } from '../lib/dane';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME[lang];
const H = helpers(lang);
const ui = t(lang);
const path = route('home', lang);
const resume = x.resume(H);
const faqs = x.faqs(H);
const keys: SourceKey[] = ['mpObw', 'eliMp', 'ustawa415', 'vat1288', 'akcyza1289', 'oplata2026', 'govplEnergia', 'wob'];
const sources = keys.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(faqs, lang)];
const pl = lang === 'pl';
const groups = navCategories(lang);
const w = widelki('pb95', 1);
const tarjetas = [
  { t: pl ? 'Olej napędowy, cena maksymalna' : 'Diesel, maximum price', v: H.l(OSTATNIA.brutto.on), d: pl ? `${H.gr(OSTATNIA.brutto.on - POPRZEDNIA.brutto.on, true)} wobec poprzedniej` : `${H.gr(OSTATNIA.brutto.on - POPRZEDNIA.brutto.on, true)} on the previous one`, href: route('diesel', lang) },
  { t: pl ? 'Benzyna 98, cena maksymalna' : 'Petrol 98, maximum price', v: H.l(OSTATNIA.brutto.pb98), d: pl ? `${H.gr(OSTATNIA.brutto.pb98 - OSTATNIA.brutto.pb95)} drożej niż 95` : `${H.gr(OSTATNIA.brutto.pb98 - OSTATNIA.brutto.pb95)} more than 95`, href: route('benzyna98', lang) },
  { t: pl ? 'Następne ogłoszenie, Pb95' : 'Next notice, petrol 95', v: `${H.gr(w.dol, true)} / ${H.gr(w.gora, true)}`, d: pl ? '8 razy na 10 w tych granicach' : '8 times out of 10 within this range', href: route('jutro', lang) },
  { t: pl ? 'LPG, średnia z tygodnia' : 'LPG, weekly average', v: H.l(LPG_ZL), d: pl ? `bez limitu, tydzień od ${H.dzien(WOB_OST.d)}` : `no cap, week of ${H.dzien(WOB_OST.d)}`, href: route('lpg', lang) },
];
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} sources={sources}>
  <header class="mb-3">
    <h1 class="text-2xl font-bold text-navy-900 md:text-4xl">{x.h1}</h1>
    <p class="mt-1 text-base text-navy-700 md:mt-2 md:text-lg">{x.intro(H)}</p>
  </header>
  <Clamp text={resume} lang={lang} id="clamp-home" sentences={1} class="mb-4" />
  <div data-outil>
    <Narzedzie tool="dzis" lang={lang} methodHref={route('method', lang)} />
  </div>
  <p class="mt-2 text-sm text-navy-600" data-chrome>{pl ? 'Dane: obwieszczenia Ministra Energii, ostatnie ogłoszone ' : 'Data: Minister of Energy notices, latest announced on '}<time datetime={OSTATNIA.ogl}>{H.date(OSTATNIA.ogl)}</time> · <a class="underline" href={route('method', lang)}>{pl ? 'Metodologia i źródła' : 'Method and sources'}</a> · <a class="underline" href={route('about', lang)}>{pl ? 'O nas' : 'About'}</a></p>
  <p class="mt-1 text-sm text-navy-600" data-chrome>{ui.independent}</p>
  <section class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-chrome aria-label={pl ? 'W skrócie' : 'At a glance'}>
    {tarjetas.map((c) => (
      <a href={c.href} class="block border-l-4 border-accent-500 bg-navy-50 px-4 py-3 hover:bg-accent-50">
        <span class="block text-xs font-semibold uppercase tracking-wide text-navy-600">{c.t}</span>
        <span class="tabular-nums block text-2xl font-bold text-navy-900">{c.v}</span>
        <span class="block text-sm text-navy-700">{c.d}</span>
      </a>
    ))}
  </section>
  <div class="prose prose-slate mt-10 max-w-none">
    <Fragment set:html={x.body(H)} />
  </div>
  <section class="mt-12" data-chrome>
    <h2 class="mb-4 text-2xl font-bold text-navy-900">{pl ? 'Wszystkie strony' : 'All pages'}</h2>
    <div class="grid gap-6 sm:grid-cols-3">
      {groups.map((g) => (
        <div><h3 class="mb-2 text-sm font-semibold uppercase tracking-wide text-navy-700">{g.label}</h3>
          <ul class="space-y-1 text-navy-800">{g.links.map((l) => <li><a class="underline decoration-navy-300 underline-offset-2 hover:text-accent-700" href={l.href}>{l.label}</a></li>)}</ul></div>
      ))}
    </div>
  </section>
</PageLayout>
