---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/fuel-prices/" title="Maximum fuel price in Poland today" width="100%" height="900" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the Polish maximum fuel price calculator – Ceny Paliw Jutro" description="Copy the code and show the maximum price of petrol 95, 98 and diesel in Poland from the latest notice on your own page, with the cost of a fill. Free, with a link." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the maximum fuel price calculator</h1>
    <p class="mt-3 text-lg text-navy-700">Copy the code and paste it into your page. The calculator shows the prices from the latest notice we have read, with its date and Monitor Polski item number.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: the link under the calculator stays visible, the calculator is not altered and it is offered without warranty. Polish version: <code>{`${SITE_URL}/embed/ceny-paliw/`}</code>.</p>
    <p><a href={route('contact', lang)}>Contact</a></p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/fuel-prices/" title="Maximum fuel price in Poland today" width="100%" height="900" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
