---
import PageLayout from '../../layouts/PageLayout.astro';
import { CLARITY_ID, CONTACT_EMAIL, GA4_ID, LAST_UPDATED, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
const lang = 'en';
const title = `Cookies – ${SITE_NAMES[lang]}`;
const description = GA4_ID ? 'Google Analytics audience-measurement cookies and nothing else: names, purpose, a 13-month maximum lifetime, provider and how to object to them in your browser.' : 'The site sets no cookies: what you type into the fuel price calculators stays in your browser and nothing is stored on your device. Details and contact here.';
---
<PageLayout title={title} description={description} lang={lang} noindex={true} breadcrumbs={[{ label: 'Cookies' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none">
    <h1>Cookies</h1>
    {GA4_ID ? (<>
    <p>The site sets Google Analytics audience-measurement cookies and only those: no advertising or social-media cookies. Processing details are in the <a href={route('privacy', lang)}>privacy policy</a>.</p>
    <h2>Cookies set</h2>
    <table><thead><tr><th>Name</th><th>Provider</th><th>Purpose</th><th>Lifetime</th></tr></thead><tbody>
    <tr><td><code>_ga</code></td><td>Google Analytics</td><td>Tells visitors apart with a random identifier</td><td>13 months at most (390 days)</td></tr>
    <tr><td><code>_ga_{GA4_ID.replace('G-', '')}</code></td><td>Google Analytics</td><td>Keeps the state of the current visit</td><td>13 months at most (390 days)</td></tr>
    </tbody></table>
    <p>Purpose: audience measurement. Google Analytics 4 does not log IP addresses; ad storage, ad personalisation and Google signals are switched off. Provider: Google Ireland Limited, Gordon House, Barrow Street, Dublin 4, Ireland. Legal basis: legitimate interest (GDPR art. 6(1)(f)).</p>
    <h2>How to object to these cookies</h2>
    <p>Block or delete cookies in your browser settings, or install the <a href="https://tools.google.com/dlpage/gaoptout" rel="nofollow noopener" target="_blank">Google Analytics opt-out add-on</a>. The site and its calculators work just the same.</p>
    </>) : (<>
    <p>The site <strong>sets no cookies</strong>. Processing details are in the <a href={route('privacy', lang)}>privacy policy</a>.</p>
    </>)}
    {CLARITY_ID && (<><h2>Microsoft Clarity, without cookies</h2><p>Page stability is measured with Microsoft Clarity in cookieless mode: no cookies, a single-use identifier for each page view, content masked. Blocking <code>clarity.ms</code> stops it.</p></>)}
    <h2>What you type</h2>
    <p>Calculations run in your browser: what you type is sent to no server and disappears when you close the page.</p>
    <p>Questions: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Last updated: {LAST_UPDATED}.</p>
  </div>
</PageLayout>
